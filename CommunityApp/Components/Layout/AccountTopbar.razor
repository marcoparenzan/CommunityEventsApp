@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ILogger<AccountTopbar> Logger
@inject EventCatalogService EventCatalog
@inject UserAuthenticationService Authentication

<header class="account-topbar">
    <a class="account-brand" href="/" aria-label="1nn0va eventi"><img src="/img/1nn0va.png" alt="1nn0va" /></a>
    @if (user is null)
    {
        <nav class="account-topbar-links" aria-label="Eventi">
            <NavLink href="/" Match="NavLinkMatch.All">Prossimi eventi</NavLink>
            <NavLink href="/past">Eventi passati</NavLink>
        </nav>
        <nav class="account-topbar-login" aria-label="Accesso">
            <NavLink href="/account" Match="NavLinkMatch.All">Accedi o registrati</NavLink>
        </nav>
    }
    else
    {
        <nav class="account-topbar-links" aria-label="Strumenti">
            @if (currentEventName is not null)
            {
                <NavLink href="/account" Match="NavLinkMatch.All">@currentEventName</NavLink>
            }
            <NavLink href="@(currentEventName is not null ? "/account/upcoming" : "/account")" Match="NavLinkMatch.All">I miei prossimi eventi</NavLink>
            <NavLink href="/account/past">I miei eventi passati</NavLink>
        </nav>
        <details class="account-user-menu">
            <summary aria-label="Apri menu utente">
                <span class="account-user-name">@DisplayName</span>
                <span class="account-user-chevron" aria-hidden="true">⌄</span>
            </summary>
            <nav class="account-user-dropdown" aria-label="Menu utente">
                <a href="/account/profile">Il mio profilo</a>
                <button type="button" @onclick="SignOutAsync" disabled="@busy">
                    @(busy ? "Uscita…" : "Esci")
                </button>
            </nav>
        </details>
    }
</header>

@code {
    private ClaimsPrincipal? user;
    private bool busy;

    // Nome e cognome se disponibili, altrimenti l'email.
    private string DisplayName =>
        user?.FindFirstValue(ClaimTypes.Name) is { Length: > 0 } name && !string.IsNullOrWhiteSpace(name)
            ? name
            : user?.FindFirstValue(ClaimTypes.Email) ?? "Account";
    private string? currentEventName;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            user = state.User;
            await LoadCurrentEventAsync();
        }
    }

    // La voce "evento attuale" compare solo se l'utente è iscritto all'evento corrente.
    private async Task LoadCurrentEventAsync()
    {
        if (user is null || !int.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var userId))
        {
            return;
        }

        try
        {
            var current = (await EventCatalog.GetAllAsync())
                .FirstOrDefault(item => item.IsCurrent && item.IsPublished && !item.IsCancelled);
            if (current is not null &&
                (await Authentication.GetRegistrationsAsync(userId)).Any(item => item.EventId == current.Id))
            {
                currentEventName = current.Name;
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not load the current event for the topbar.");
        }
    }

    private async Task SignOutAsync()
    {
        busy = true;
        try
        {
            var result = await JS.InvokeAsync<ClientResponse>("eventsAccount.signOut");
            if (result.Ok)
            {
                Navigation.NavigateTo("/account", forceLoad: true);
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not sign out from the user menu.");
        }
        finally
        {
            busy = false;
        }
    }

    private sealed record ClientResponse(bool Ok, string Message);
}
