</div>

@code {
  
    HttpClient httpClient = new();

    SpeakerInfo[] speakers = [];

    IGrouping<DateTimeOffset, Session>[] sessionsSlots = [];

    string[] rooms = [];
    string scheduleError = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var eventInfo = await EventCatalog.GetAsync(2026, "1nn0vAI");
                if (eventInfo is null || !Uri.TryCreate(eventInfo.SessionizeJsonUri, UriKind.Absolute, out var sessionizeUri) ||
                    sessionizeUri.Scheme != Uri.UriSchemeHttps ||
                    !string.Equals(sessionizeUri.Host, "sessionize.com", StringComparison.OrdinalIgnoreCase) ||
                    !sessionizeUri.AbsolutePath.EndsWith("/view/All", StringComparison.OrdinalIgnoreCase))
                {
                    throw new InvalidOperationException("L'evento 2026 non ha un URL JSON Sessionize valido.");
                }

                var apiBase = sessionizeUri.AbsoluteUri[..sessionizeUri.AbsoluteUri.LastIndexOf("/view/All", StringComparison.OrdinalIgnoreCase)] + "/view";
                speakers = await httpClient.GetFromJsonAsync<SpeakerInfo[]>($"{apiBase}/Speakers")
                    ?? throw new InvalidOperationException("Sessionize non ha restituito i relatori.");
                var sessionizeData = await httpClient.GetFromJsonAsync<SessionizeAllResponse>(sessionizeUri)
                    ?? throw new InvalidOperationException("Sessionize non ha restituito l'agenda.");
                var roomsById = sessionizeData.Rooms.ToDictionary(room => room.Id);
                var speakersById = sessionizeData.Speakers.ToDictionary(speaker => speaker.Id);

                rooms = sessionizeData.Rooms.Select(room => room.Name).Distinct().ToArray();
                sessionsSlots = sessionizeData.Sessions
                    .Where(session => !session.IsServiceSession)
                    .Select(session => new Session
                    {
                        Id = session.Id,
                        Title = session.Title,
                        Description = session.Description,
                        StartsAt = session.StartsAt,
                        EndsAt = session.EndsAt,
                        IsServiceSession = session.IsServiceSession,
                        RoomId = session.RoomId,
                        Room = roomsById.TryGetValue(session.RoomId, out var room) ? room.Name : string.Empty,
                        Speakers = session.Speakers
                            .Select(value => Guid.TryParse(value, out var id) ? id : Guid.Empty)
                            .Where(id => id != Guid.Empty)
                            .Where(speakersById.ContainsKey)
                            .Select(id => new Speaker { Id = id, Name = speakersById[id].FullName })
                            .ToList()
                    })
                    .GroupBy(session => session.StartsAt)
                    .ToArray();
            }
            catch (Exception)
            {
                scheduleError = "Non è stato possibile caricare l'agenda da Sessionize.";
            }
            StateHasChanged();
        }
    }

    MarkupString SessionDescriptionOf(Session sessionInfo)
    {
        if (string.IsNullOrWhiteSpace(sessionInfo.Description)) return (MarkupString)"&nbsp;";
        return new MarkupString(sessionInfo.Description);
    }

    Session[] Complete(IEnumerable<Session> group)
    {
        return rooms.Select(xx =>
        {
            var session = group.SingleOrDefault(yy => yy.Room == xx);
            if (session is not null) return session;
            return new Session
                {
                    Room = xx
                };
        }).ToArray();
    }
}