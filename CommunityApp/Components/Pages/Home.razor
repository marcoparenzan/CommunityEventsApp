<!-- Start: Schedule -->
<section class="schedule">
    <div class="container">
        <div class="row me-row" id="schedule">
            <h2 class="row-title content-ct col-12">Agenda</h2>
            @if (!string.IsNullOrWhiteSpace(scheduleError))
            {
                <p class="col-12" role="alert">@scheduleError</p>
            }
            <div class="col-12">
                <div class="row room-headers">
                    @foreach (var room in rooms)
                    {
                        <div class="col-lg-3 col-md-6 col-12">
                            <div class="d-flex gap-2">
                                <div class="media-body w-100">
                                    <h5>@room</h5>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                @foreach (var sessionsSlot in sessionsSlots)
                {
                    <div class="row">
                        <h4 class="media-heading col-12">@sessionsSlot.Key.ToString("HH:mm")</h4>
                        @foreach (var session in Complete(sessionsSlot))
                        {
                            <div class="col-lg-3 col-md-6 col-12">
                                <div class="d-flex gap-2">
                                    <div class="media-body w-100">
                                        @if (!string.IsNullOrWhiteSpace(session.Title))
                                        {
                                            <div class="room-badge">📍 @session.Room</div>
                                            <h5>@session.Title</h5>
                                            <h6>
                                                @if (session.Speakers is not null && session.Speakers.Any())
                                                {
                                                    var speakerCount = 0;
                                                    foreach (var speaker in session.Speakers)
                                                    {
                                                        var speakerInfo = speakers.SingleOrDefault(xx => xx.Id == speaker.Id);
                                                        if (speakerInfo is not null)
                                                        {
                                                            if (speakerCount > 0)
                                                            {
                                                                <text>, </text>
                                                            }

                                                            @if (speakerInfo.HasValidUrl())
                                                            {
                                                                <a href="@speakerInfo.SpeakerUrl()">@speakerInfo.FirstName @speakerInfo.LastName</a>
                                                            }
                                                            else
                                                            {
                                                                <span>@speakerInfo.FirstName @speakerInfo.LastName</span>
                                                            }

                                                            speakerCount++;
                                                        }
                                                    }
                                                }
                                            </h6>
                                            <p>@SessionDescriptionOf(session)</p>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>
<!-- End: Schedule -->
<div class="container speaker">
    <!-- Start: Speakers -->
    <div class="row me-row content-ct" id="speakers">
        <h2 class="row-title">Speakers</h2>
        @foreach (var speaker in speakers.OrderBy(xx => Random.Shared.Next()))
        {
            <div class="col-md-3 col-sm-6 col-12 mb-3">
                <div>
                    <img src="@speaker.ProfilePicture" class="speaker-img" alt="@speaker.FirstName @speaker.LastName">
                    <h3>
                        @if (speaker.HasValidUrl())
                        {
                            <a href="@speaker.SpeakerUrl()">@speaker.FirstName @speaker.LastName</a>
                        }
                        else
                        {
                            <span>@speaker.FirstName @speaker.LastName</span>
                        }
                    </h3>
                </div>
            </div>
        }
    </div>
    <!-- End: Speakers -->
</div>

