@page "/checkin/confirm/{Token}"
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject ILogger<EventConfirmation> Logger

<PageTitle>Conferma · 1nn0va</PageTitle>
<HeadContent>
    <meta name="referrer" content="no-referrer" />
</HeadContent>

<main class="account-site checkin-site">
    <header class="account-topbar">
        <a class="account-brand" href="/"><img src="/img/1nn0va.png" alt="1nn0va" /><span>Eventi</span></a>
    </header>
    <section class="account-content">
        <p class="event-eyebrow">Conferma email</p>
        <h1>Conferma la tua operazione</h1>
        <section class="account-card">
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <p class="account-message" role="@(isError ? "alert" : "status")">@message</p>
            }
            @if (!isComplete)
            {
                @if (string.IsNullOrWhiteSpace(message))
                {
                    <p>Premi il pulsante per confermare l’indirizzo email e completare l’iscrizione o il check-in. Il link è monouso e scade dopo 30 minuti.</p>
                }
                <button class="event-button" @onclick="ConfirmAsync" disabled="@busy">@(busy ? "Conferma…" : "Conferma")</button>
            }
            <p><a href="/account">Vai all’area personale</a></p>
        </section>
    </section>
</main>

@code {
    [Parameter]
    public string Token { get; set; } = string.Empty;

    private string message = string.Empty;
    private bool busy;
    private bool isError;
    private bool isComplete;

    private async Task ConfirmAsync()
    {
        busy = true;
        try
        {
            var result = await JS.InvokeAsync<ClientResponse>("eventsCheckIn.confirm", Token);
            message = result.Message;
            isError = !result.Ok;
            isComplete = result.Ok;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "The email confirmation request failed.");
            message = "Non è stato possibile completare la conferma. Riprova o richiedi un nuovo link.";
            isError = true;
        }
        finally
        {
            busy = false;
        }
    }

    private sealed record ClientResponse(bool Ok, string Message);
}
