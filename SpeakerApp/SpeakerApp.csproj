<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SpeakerApp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="EventsCommon.Models" />
    <Using Include="EventsCommon.Services" />
    <Using Include="SpeakerApp.Services" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EventsCommon\EventsCommon.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.template.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
