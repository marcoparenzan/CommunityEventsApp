@using Microsoft.AspNetCore.Components.Forms
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILogger<ImportInput> Logger

<div class="import-input">
    <div class="import-step">
        <span class="import-step-title">File (.xlsx o .csv)</span>
        <InputFile OnChange="OnFileSelected" accept=".xlsx,.csv" disabled="@Disabled" />
        <p class="import-hint">Il file viene convertito in testo CSV nell’editor qui sotto: da lì la verifica e l’importazione sono sempre le stesse. Puoi anche incollare il testo direttamente.</p>
    </div>
    <div class="import-step">
        <span class="import-step-title">Testo CSV</span>
        <div id="@editorId" class="csv-editor"></div>
        <p class="import-hint">Prima riga con le intestazioni. Separatore virgola, punto e virgola o tabulazione, riconosciuto in automatico; ogni colonna ha un colore diverso.</p>
        @if (!string.IsNullOrEmpty(error))
        {
            <p class="import-error" role="alert">@error</p>
        }
        <button type="button" class="import-verify" @onclick="VerifyAsync" disabled="@Disabled">Verifica testo</button>
    </div>
</div>

@code {
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Placeholder { get; set; } = string.Empty;
    /// <summary>When set, only these columns of an Excel file are copied into the text (the others are ignored).</summary>
    [Parameter] public IReadOnlyList<string>? Columns { get; set; }
    /// <summary>Raised with the CSV text (UTF-8 bytes) and a ".csv" file name.</summary>
    [Parameter] public EventCallback<(byte[] Data, string Name)> OnData { get; set; }

    private readonly string editorId = "csv-editor-" + Guid.NewGuid().ToString("N");
    private string error = string.Empty;
    private bool ready;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("eventsCsvEditor.init", editorId, string.Empty, Placeholder);
            ready = true;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not start the CSV editor.");
            error = "Non è stato possibile caricare l’editor (serve la connessione a internet).";
            StateHasChanged();
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs args)
    {
        error = string.Empty;
        try
        {
            await using var upload = args.File.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var buffer = new MemoryStream();
            await upload.CopyToAsync(buffer);
            var csv = UserImportService.ToCsvText(buffer.ToArray(), args.File.Name, Columns);
            await JS.InvokeVoidAsync("eventsCsvEditor.setText", editorId, csv);
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
            return;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not read the selected file.");
            error = "Non è stato possibile leggere il file. Controlla che sia un .xlsx o .csv (massimo 5 MB).";
            return;
        }

        // Il testo appena caricato viene verificato subito; si può correggere e verificare di nuovo.
        await VerifyAsync();
    }

    private async Task VerifyAsync()
    {
        error = string.Empty;
        var text = ready ? await JS.InvokeAsync<string>("eventsCsvEditor.getText", editorId) : string.Empty;
        if (string.IsNullOrWhiteSpace(text))
        {
            error = "Il testo è vuoto: seleziona un file o incolla i dati.";
            return;
        }

        await OnData.InvokeAsync((System.Text.Encoding.UTF8.GetBytes(text), "incollato.csv"));
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("eventsCsvEditor.dispose", editorId);
        }
        catch (Exception)
        {
            // Circuito già chiuso: niente da liberare lato browser.
        }
    }
}
